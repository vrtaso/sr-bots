# Скопируйте этот файл в .env и заполните реальными значениями.
# На Replit этот файл НЕ нужен — используйте вкладку Secrets вместо него.

BOT_TOKEN_ANKETA=вставьте_токен_бота_анкет
MODERATOR_ID=123456789

BOT_TOKEN_COMPLAINTS=вставьте_токен_бота_жалоб
MODERATOR_ID_COMPLAINTS=123456789

# Общий чат клана — куда придёт объявление о новом принятом участнике.
# Бот anketa_bot должен быть добавлен в этот чат.
CLAN_CHAT_ID=-1001234567890

# Необязательно: ссылка-приглашение в чат клана, отправляется одобренному участнику.
CLAN_INVITE_LINK=https://t.me/+ваша_ссылка
